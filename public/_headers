# Cloudflare Pages liest diese Datei automatisch aus.
# Sicherheits-Header und Caching - nichts davon ist Pflicht,
# aber es kostet nichts und macht die Seite messbar besser.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Schriften ändern sich nie - ein Jahr im Browser-Cache halten
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
