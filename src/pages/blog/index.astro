---
import Basis from '../../layouts/Basis.astro';
import BlogKarte from '../../components/BlogKarte.astro';
import { BEREICHE } from '../../bereiche';
import { pfad } from '../../pfad';
import { getCollection } from 'astro:content';

// Entwürfe erscheinen beim lokalen Arbeiten, aber nie auf der
// fertigen Seite. import.meta.env.PROD ist beim Bauen true.
const proBereich = await Promise.all(
  BEREICHE.map(async (bereich) => {
    const eintraege = await getCollection(bereich.id, ({ data }) =>
      import.meta.env.PROD ? !data.entwurf : true
    );
    return { bereich, eintraege };
  })
);

const artikel = proBereich
  .flatMap(({ bereich, eintraege }) => eintraege.map((eintrag) => ({ bereich, eintrag })))
  .sort(
    (a, z) => z.eintrag.data.veroeffentlicht.valueOf() - a.eintrag.data.veroeffentlicht.valueOf()
  );

const gesamt = artikel.length;
---

<Basis
  titel="Blog"
  beschreibung="Alle Texte von mitwachsen an einem Ort - für Eltern, Auszubildende und Fachkräfte, filterbar nach Bereich."
>
  <div class="huelle">
    <header class="blog__kopf">
      <p class="augenbraue">Alle Texte</p>
      <h1>Blog</h1>
      <p class="blog__text spalte">
        Jeder Artikel von mitwachsen an einem Ort. Mit den Reitern lässt sich
        die Liste nach Bereich eingrenzen.
      </p>
    </header>

    <div class="filter" role="group" aria-label="Nach Bereich filtern">
      <button type="button" class="filter__knopf" data-filter="alle" aria-pressed="true">
        Alle
        <span class="filter__zahl">{gesamt}</span>
      </button>
      {
        proBereich.map(({ bereich, eintraege }) => (
          <button
            type="button"
            class="filter__knopf"
            data-filter={bereich.id}
            aria-pressed="false"
          >
            {bereich.name}
            <span class="filter__zahl">{eintraege.length}</span>
          </button>
        ))
      }
    </div>

    {
      gesamt === 0 ? (
        <p class="leise">
          Hier entstehen gerade die ersten Texte. Schau in ein paar Tagen
          wieder vorbei.
        </p>
      ) : (
        <>
          <ul class="bloggrid" id="bloggrid">
            {artikel.map(({ bereich, eintrag }) => (
              <BlogKarte
                url={pfad(`${bereich.pfad}${eintrag.id}/`)}
                bereich={bereich}
                titel={eintrag.data.titel}
                beschreibung={eintrag.data.beschreibung}
                veroeffentlicht={eintrag.data.veroeffentlicht}
                schlagworte={eintrag.data.schlagworte}
                titelbild={eintrag.data.titelbild}
              />
            ))}
          </ul>
          <p class="leise" id="bloggrid-leer" hidden>
            In diesem Bereich entstehen gerade die ersten Texte. Schau in ein
            paar Tagen wieder vorbei.
          </p>
        </>
      )
    }
  </div>
</Basis>

<script>
  const knoepfe = document.querySelectorAll('.filter__knopf');
  const karten = document.querySelectorAll('#bloggrid > li');
  const leerHinweis = document.getElementById('bloggrid-leer');

  function anwenden(filter: string) {
    let sichtbar = 0;
    karten.forEach((karte) => {
      const el = karte as HTMLLIElement;
      const treffer = filter === 'alle' || el.dataset.bereich === filter;
      el.hidden = !treffer;
      if (treffer) sichtbar++;
    });
    knoepfe.forEach((knopf) => {
      const el = knopf as HTMLButtonElement;
      const aktiv = el.dataset.filter === filter;
      el.classList.toggle('filter__knopf--aktiv', aktiv);
      el.setAttribute('aria-pressed', String(aktiv));
    });
    if (leerHinweis) leerHinweis.hidden = karten.length === 0 || sichtbar > 0;
  }

  const gueltigeFilter = Array.from(knoepfe).map((k) => (k as HTMLButtonElement).dataset.filter);
  const start = new URLSearchParams(location.search).get('bereich');
  anwenden(start && gueltigeFilter.includes(start) ? start : 'alle');

  knoepfe.forEach((knopf) => {
    knopf.addEventListener('click', () => {
      const filter = (knopf as HTMLButtonElement).dataset.filter ?? 'alle';
      anwenden(filter);

      const url = new URL(location.href);
      if (filter === 'alle') url.searchParams.delete('bereich');
      else url.searchParams.set('bereich', filter);
      history.replaceState(null, '', url);
    });
  });
</script>

<style>
  .blog__kopf {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 1.5rem;
    border-bottom: 3px solid var(--akzent);
    margin-bottom: 2rem;
  }

  .blog__kopf h1 {
    color: var(--akzent);
    margin-bottom: 0.35em;
  }

  .blog__text {
    font-size: clamp(1.05rem, 0.5vw + 1rem, 1.2rem);
    color: var(--tinte-leise);
    margin: 0;
  }

  /* ============ Filter ============ */
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  .filter__knopf {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--schrift-display);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--tinte-leise);
    background: var(--karte);
    border: 1.5px solid var(--haarlinie);
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }

  .filter__knopf:hover {
    border-color: var(--akzent);
    color: var(--tinte);
  }

  .filter__zahl {
    font-size: 0.8125rem;
    font-weight: 500;
    color: inherit;
    opacity: 0.7;
  }

  .filter__knopf[data-filter='alle'].filter__knopf--aktiv {
    background: var(--tinte);
    border-color: var(--tinte);
    color: var(--papier);
  }
  .filter__knopf[data-filter='familie'].filter__knopf--aktiv {
    background: var(--familie);
    border-color: var(--familie);
    color: var(--papier);
  }
  .filter__knopf[data-filter='praxis'].filter__knopf--aktiv {
    background: var(--praxis);
    border-color: var(--praxis);
    color: var(--papier);
  }
  .filter__knopf[data-filter='lernen'].filter__knopf--aktiv {
    background: var(--lernen);
    border-color: var(--lernen);
    color: var(--papier);
  }

  /* ============ Ergebnisliste ============ */
  .bloggrid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1.5rem;
    padding-bottom: 4rem;
  }
</style>
