---
import Basis from '../../layouts/Basis.astro';

// ============================================================
// Diese Seite ist bewusst nicht verlinkt und steht auf noindex.
//
// Solange nichts kaufbar ist, hat ein Shop auf der Seite nichts zu
// suchen: Ein Laden mit leeren Regalen schadet mehr, als er nützt.
// Die Adresse bleibt trotzdem bestehen, damit sie beim Start des
// ersten Produkts nur noch gefüllt und in die Navigation gehängt
// werden muss.
//
// Wieder freischalten, wenn ein Produkt wirklich verkauft wird:
//   1. Diese Seite mit dem Produkt füllen
//   2. nichtIndexieren unten entfernen
//   3. Link in src/components/Kopf.astro wieder eintragen
// ============================================================
---

<Basis
  titel="Guides"
  beschreibung="Vertiefende Leitfäden zu den Rechnern von mitwachsen."
  nichtIndexieren
>
  <div class="huelle inhaltsseite">
    <h1>Guides</h1>
    <p class="spalte">
      Zu den Rechnern entstehen vertiefende Leitfäden. Der erste ist ein
      14-Tage-Umstellungsplan zum Kita-Schlaf: ein Ablauf, der die
      Empfehlungen des Rechners über zwei Wochen in konkrete Schritte
      übersetzt.
    </p>
    <p class="spalte">
      Sobald der Plan fertig ist, finden Sie ihn hier und unter dem
      Ergebnis des Rechners.
    </p>
  </div>
</Basis>

<style>
  .inhaltsseite {
    padding-block: var(--raum-64);
    max-width: calc(var(--spalte) + 2 * var(--rand));
    margin-inline: auto;
  }
</style>
