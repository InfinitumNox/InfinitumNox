---
/**
 * Die Startseite hat genau eine Aufgabe: Eine Mutter, die abends um
 * 21:40 Uhr sucht, soll ihr Problem sofort wiedererkennen und den
 * Rechner benutzen können - ohne einen weiteren Klick.
 *
 * Deshalb steht das Werkzeug hier, nicht auf einer Unterseite. Bei
 * einer Ein-Werkzeug-Seite ist das Werkzeug die Startseite.
 */
import Basis from '../layouts/Basis.astro';
import SchlafRechner from '../components/SchlafRechner.astro';
import Autorin from '../components/Autorin.astro';
import Quellen from '../components/Quellen.astro';
import { BEREICHE } from '../bereiche';
import { pfad } from '../pfad';
import { getCollection } from 'astro:content';

// Artikel für die Startseite.
//
// Vorrang haben Texte zum Schlaf - erkannt am Schlagwort "Schlaf".
// Sobald es davon genug gibt, stehen hier ausschließlich Schlafthemen.
// Bis dahin wird mit den neuesten übrigen Artikeln aufgefüllt, damit
// die Seite nicht halb leer wirkt. Bereiche ohne Artikel fallen still
// weg; eine Karte mit "kommt noch" wäre schlechter als keine Karte.
const ANZAHL_ARTIKEL = 4;

const alle = (
  await Promise.all(
    BEREICHE.map(async (bereich) => {
      const eintraege = await getCollection(bereich.id, ({ data }) => !data.entwurf);
      return eintraege.map((eintrag) => ({ bereich, eintrag }));
    })
  )
).flat();

const nachDatum = (a: (typeof alle)[number], z: (typeof alle)[number]) =>
  z.eintrag.data.veroeffentlicht.valueOf() - a.eintrag.data.veroeffentlicht.valueOf();

const istSchlafthema = ({ eintrag }: (typeof alle)[number]) =>
  eintrag.data.schlagworte.some((s) => s.toLowerCase().includes('schlaf'));

const schlafartikel = alle.filter(istSchlafthema).sort(nachDatum);
const uebrige = alle.filter((a) => !istSchlafthema(a)).sort(nachDatum);
const artikel = [...schlafartikel, ...uebrige].slice(0, ANZAHL_ARTIKEL);
---

<Basis
  titel="Wann muss mein Kita-Kind ins Bett?"
  beschreibung="Berechnen Sie das Schlaffenster Ihres Kindes - abgestimmt auf Aufstehzeit, Alter und den Mittagsschlaf in der Kita."
  startAktiv
>
  <section class="huelle held">
    <h1 class="held__satz">Wann muss mein Kita-Kind ins Bett?</h1>
    <p class="held__text spalte">
      Berechnen Sie das Schlaffenster Ihres Kindes &ndash; abgestimmt auf
      Aufstehzeit, Alter und den Mittagsschlaf in der Kita.
    </p>
  </section>

  <div class="huelle">
    <SchlafRechner />
  </div>

  <div class="huelle vertrauen">
    <Autorin />
    <Quellen />
  </div>

  {
    artikel.length > 0 && (
      <section class="huelle abschnitt" id="artikel" aria-labelledby="artikel-titel">
        <h2 id="artikel-titel" class="abschnitt__titel">
          Mehr zum Schlaf von Kita-Kindern
        </h2>
        <ul class="artikelliste">
          {artikel.map(({ bereich, eintrag }) => (
            <li class="akarte">
              <h3 class="akarte__titel">
                <a href={pfad(`${bereich.pfad}${eintrag.id}/`)}>{eintrag.data.titel}</a>
              </h3>
              <p class="akarte__text leise">{eintrag.data.beschreibung}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Basis>

<style>
  /* ============ Held (Hero) ============
     Kein Blatt-Symbol über der Überschrift: Das Logo steht schon im
     Kopfbereich, die Wiederholung schwächt beides. Und kein
     zentrierter Fließtext - linksbündig liest sich besser. */
  .held {
    padding-block: var(--raum-48) var(--raum-24);
  }

  .held__satz {
    max-width: 18ch;
    font-size: var(--gross-h1);
    line-height: var(--zeile-h1);
    letter-spacing: -0.025em;
    margin: 0 0 var(--raum-12);
  }

  .held__text {
    font-size: var(--gross-text);
    line-height: var(--zeile-text);
    color: var(--tinte-leise);
    margin: 0;
  }

  /* ============ Vertrauensbereich ============ */
  .vertrauen {
    display: grid;
    gap: var(--raum-16);
    margin-top: var(--raum-24);
  }

  /* ============ Abschnitte ============
     scroll-margin-top steht zentral in global.css für jedes Element
     mit id - hier nichts wiederholen, sonst gewinnt der schwächere
     Wert und der Ankersprung landet hinter dem Kopfbereich. */
  .abschnitt__titel {
    font-size: var(--gross-h2);
    line-height: var(--zeile-h2);
    margin: var(--raum-48) 0 var(--raum-16);
  }

  /* ============ Artikel ============ */
  .artikelliste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--raum-12);
  }

  .akarte {
    background: var(--karte);
    border: 1px solid var(--haarlinie);
    border-radius: var(--karte-radius);
    box-shadow: var(--karte-schatten);
    padding: var(--karte-innen-mobil);
  }

  .akarte__titel {
    font-size: var(--gross-h3);
    line-height: var(--zeile-h3);
    margin: 0 0 var(--raum-4);
  }
  .akarte__titel a {
    text-decoration: none;
  }
  .akarte__titel a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .akarte__text {
    margin: 0;
    font-size: var(--gross-klein);
    line-height: var(--zeile-klein);
  }

  @media (min-width: 48rem) {
    .held {
      padding-block: var(--raum-64) var(--raum-32);
    }
    .vertrauen {
      gap: var(--raum-24);
      margin-top: var(--raum-32);
    }
    .artikelliste {
      gap: var(--raum-24);
    }
    .akarte {
      padding: var(--raum-24);
    }
  }
</style>
