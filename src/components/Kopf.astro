---
import { pfad } from '../pfad';

/**
 * Der Kopfbereich. Zwei Regeln:
 *
 *  1. Die Navigation bleibt einzeilig - auch auf einem schmalen Handy.
 *     Bricht sie um, frisst sie die wertvollste Fläche der Seite, die
 *     über der Falz. Deshalb höchstens drei Einträge.
 *  2. "Start" steht bewusst nicht in der Liste: Das Logo links führt
 *     schon dorthin, und weil der Rechner auf der Startseite sitzt,
 *     wäre "Start" neben "Rechner" zweimal dasselbe Ziel.
 */
interface Props {
  startAktiv?: boolean;
  blogAktiv?: boolean;
  ueberAktiv?: boolean;
}
const { startAktiv = false, blogAktiv = false, ueberAktiv = false } = Astro.props;
---

<header class="kopf">
  <div class="huelle kopf__innen">
    <a href={pfad("/")} class="marke" aria-label="mitwachsen, zur Startseite">
      <img src={pfad("/logo.svg")} alt="" class="marke__logo" width="32" height="32" />
      mitwachsen
    </a>

    <nav aria-label="Hauptnavigation">
      <ul class="nav">
        <li>
          <a
            href={startAktiv ? '#kita-schlaf' : `${pfad("/")}#kita-schlaf`}
            class:list={['nav__link', { 'nav__link--aktiv': startAktiv }]}
            aria-current={startAktiv ? 'page' : undefined}
          >
            Rechner
          </a>
        </li>
        <li>
          <a
            href={pfad("/blog/")}
            class:list={['nav__link', { 'nav__link--aktiv': blogAktiv }]}
            aria-current={blogAktiv ? 'page' : undefined}
          >
            Blog
          </a>
        </li>
        <li>
          <a
            href={pfad("/ueber/")}
            class:list={['nav__link', { 'nav__link--aktiv': ueberAktiv }]}
            aria-current={ueberAktiv ? 'page' : undefined}
          >
            Über
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .kopf {
    border-bottom: 1px solid var(--haarlinie);
    background: var(--papier);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  /* Feste Höhe statt Innenabstand: So stimmt --kopf-hoehe garantiert
     mit der tatsächlichen Höhe überein, und Ankersprünge landen nicht
     hinter dem Kopfbereich. */
  .kopf__innen {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--raum-16);
    height: var(--kopf-hoehe);
  }

  .marke {
    display: inline-flex;
    align-items: center;
    gap: var(--raum-8);
    font-family: var(--schrift-display);
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .marke__logo {
    display: block;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }
  .marke:hover {
    color: var(--tinte);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  /* nowrap ist hier die eigentliche Anforderung: Die Navigation darf
     unter keinen Umständen in eine zweite Zeile rutschen. */
  .nav {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--raum-16);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    font-family: var(--schrift-display);
    font-weight: 500;
    font-size: var(--gross-klein);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    display: inline-block;
    padding-block: var(--raum-8);
    border-bottom: 2px solid transparent;
  }

  .nav__link:hover { color: var(--akzent); }

  .nav__link--aktiv {
    color: var(--akzent);
    border-bottom-color: var(--akzent);
  }

  @media (min-width: 30rem) {
    .marke { font-size: 1.3rem; }
    .marke__logo { width: 28px; height: 28px; }
    .nav { gap: var(--raum-24); }
    .nav__link { font-size: 1rem; }
  }
</style>
