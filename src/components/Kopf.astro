---
import { pfad } from '../pfad';

interface Props {
  startAktiv?: boolean;
  blogAktiv?: boolean;
  guidesAktiv?: boolean;
}
const { startAktiv = false, blogAktiv = false, guidesAktiv = false } = Astro.props;
---

<header class="kopf">
  <div class="huelle kopf__innen">
    <a href={pfad("/")} class="marke" aria-label="mitwachsen, zur Startseite">
      <img src={pfad("/logo.svg")} alt="" class="marke__logo" width="32" height="32" />
      mitwachsen
    </a>

    <nav aria-label="Hauptnavigation">
      <ul class="nav">
        <li>
          <a
            href={pfad("/")}
            class:list={['nav__link', { 'nav__link--aktiv': startAktiv }]}
            aria-current={startAktiv ? 'page' : undefined}
          >
            Start
          </a>
        </li>
        <li>
          <a href={`${pfad("/")}#rechner`} class="nav__link">Rechner</a>
        </li>
        <li>
          <a
            href={pfad("/guides/")}
            class:list={['nav__link', { 'nav__link--aktiv': guidesAktiv }]}
            aria-current={guidesAktiv ? 'page' : undefined}
          >
            Guides
          </a>
        </li>
        <li>
          <a
            href={pfad("/blog/")}
            class:list={['nav__link', { 'nav__link--aktiv': blogAktiv }]}
            aria-current={blogAktiv ? 'page' : undefined}
          >
            Blog
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .kopf {
    border-bottom: 1px solid var(--haarlinie);
    background: var(--papier);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .kopf__innen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.1rem;
  }

  .marke {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--schrift-display);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .marke__logo {
    display: block;
    width: 1.7rem;
    height: 1.7rem;
  }
  .marke:hover {
    color: var(--tinte);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    font-family: var(--schrift-display);
    font-weight: 500;
    font-size: 1rem;
    text-decoration: none;
    padding-bottom: 0.3rem;
    border-bottom: 2px solid transparent;
  }

  .nav__link:hover { color: var(--akzent); }

  .nav__link--aktiv {
    color: var(--akzent);
    border-bottom-color: var(--akzent);
  }
</style>
