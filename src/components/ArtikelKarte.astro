---
interface Props {
  url: string;
  titel: string;
  beschreibung: string;
  veroeffentlicht: Date;
  schlagworte?: string[];
  titelbild?: string;
}
const { url, titel, beschreibung, veroeffentlicht, schlagworte = [], titelbild } = Astro.props;

const datumLesbar = veroeffentlicht.toLocaleDateString('de-DE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const datumMaschine = veroeffentlicht.toISOString().slice(0, 10);
---

<article class="karte">
  {titelbild && (
    <a href={url} class="karte__bild-link" tabindex="-1" aria-hidden="true">
      <img class="karte__bild" src={titelbild} alt="" loading="lazy" />
    </a>
  )}
  <h3 class="karte__titel">
    <a href={url}>{titel}</a>
  </h3>
  <p class="karte__text leise">{beschreibung}</p>
  <p class="karte__meta leise">
    <time datetime={datumMaschine}>{datumLesbar}</time>
    {
      schlagworte.length > 0 && (
        <>
          <span aria-hidden="true"> · </span>
          <span>{schlagworte.join(', ')}</span>
        </>
      )
    }
  </p>
</article>

<style>
  .karte {
    padding: var(--raum-24) 0;
    border-bottom: 1px solid var(--haarlinie);
  }

  .karte__bild-link {
    display: block;
    margin-bottom: var(--raum-16);
  }

  .karte__bild {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 8px;
  }

  .karte__titel {
    font-size: var(--gross-h3);
    line-height: var(--zeile-h3);
    margin: 0 0 var(--raum-8);
  }

  .karte__titel a {
    text-decoration: none;
  }
  .karte__titel a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .karte__text {
    margin: 0 0 var(--raum-8);
    max-width: var(--spalte);
  }

  .karte__meta {
    margin: 0;
    font-size: var(--gross-klein);
    line-height: var(--zeile-klein);
  }
</style>
