---
import { BEREICHE } from '../bereiche';
import { pfad } from '../pfad';
const jahr = new Date().getFullYear();
---

<footer class="fuss">
  <div class="huelle fuss__innen">
    <div>
      <p class="fuss__marke">mitwachsen</p>
      <p class="leise fuss__zeile">
        Pädagogisches Wissen zum Schlaf von Kita-Kindern. Keine
        medizinische Beratung.
      </p>
    </div>

    <nav aria-label="Bereiche" class="fuss__block">
      <h2 class="fuss__titel">Bereiche</h2>
      <ul>
        {BEREICHE.map((b) => <li><a href={pfad(b.pfad)}>{b.name}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Rechtliches" class="fuss__block">
      <h2 class="fuss__titel">Rechtliches</h2>
      <ul>
        <!-- Impressum und Datenschutz MÜSSEN von jeder Seite aus mit
             einem Klick erreichbar sein. Das ist keine Empfehlung,
             das ist Pflicht. -->
        <li><a href={pfad("/impressum/")}>Impressum</a></li>
        <li><a href={pfad("/datenschutz/")}>Datenschutz</a></li>
        <li><a href={pfad("/kontakt/")}>Kontakt</a></li>
        <li><a href={pfad("/ueber/")}>Über mich</a></li>
      </ul>
    </nav>
  </div>

  <div class="huelle">
    <p class="leise fuss__unten">© {jahr} mitwachsen</p>
  </div>
</footer>

<style>
  .fuss {
    border-top: 1px solid var(--haarlinie);
    margin-top: var(--raum-96);
    padding-block: var(--raum-48) var(--raum-32);
    font-size: var(--gross-klein);
    line-height: var(--zeile-klein);
  }

  .fuss__innen {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--raum-32);
  }

  .fuss__marke {
    font-family: var(--schrift-display);
    font-weight: 600;
    font-size: 1.15rem;
    margin: 0 0 var(--raum-4);
  }

  .fuss__zeile { margin: 0; max-width: 26ch; }

  .fuss__titel {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--tinte-leise);
    margin: 0 0 var(--raum-12);
  }

  .fuss__block ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--raum-8);
  }

  .fuss__block a { text-decoration: none; }
  .fuss__block a:hover { text-decoration: underline; text-underline-offset: 0.18em; }

  .fuss__unten {
    margin: var(--raum-48) 0 0;
    padding-top: var(--raum-24);
    border-top: 1px solid var(--haarlinie);
    font-size: var(--gross-klein);
  }
</style>
