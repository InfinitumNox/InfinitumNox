---
// Kleine Strich-Icons für Bereiche und Rechner. Bewusst als eigene
// Komponente, damit neue Symbole an einer Stelle dazukommen.
interface Props {
  name: 'eltern' | 'lernen' | 'praxis' | 'bett' | 'smartphone' | 'mond' | 'kalender';
}
const { name } = Astro.props;
---

{
  name === 'eltern' && (
    <svg class="symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="9" cy="8" r="3" />
      <path d="M4 20c0-3 2.2-5 5-5s5 2 5 5" />
      <circle cx="17" cy="9" r="2.3" />
      <path d="M14.6 20c.2-2.2 1.7-3.8 3.6-3.8 2.1 0 3.6 1.6 3.8 3.8" />
    </svg>
  )
}
{
  name === 'lernen' && (
    <svg class="symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 5.5c2-1 5-1 8 .8V19c-3-1.8-6-1.8-8-.8Z" />
      <path d="M20 5.5c-2-1-5-1-8 .8V19c3-1.8 6-1.8 8-.8Z" />
    </svg>
  )
}
{
  name === 'praxis' && (
    <svg class="symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6.5 20c-2.3-5-.3-11.3 5.5-14 5.8 2.7 7.8 9 5.5 14-3.7 1.8-7.3 1.8-11 0Z" />
      <path d="M12 20V8.5" />
    </svg>
  )
}
{
  name === 'bett' && (
    <svg class="symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 19v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6" />
      <path d="M3 19h18" />
      <path d="M3 13v6" />
      <path d="M21 13v6" />
      <rect x="5" y="9" width="5" height="4" rx="1" />
    </svg>
  )
}
{
  name === 'smartphone' && (
    <svg class="symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="7" y="3" width="10" height="18" rx="2" />
      <line x1="11" y1="18" x2="13" y2="18" />
    </svg>
  )
}
{
  name === 'mond' && (
    <svg class="symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" />
    </svg>
  )
}
{
  name === 'kalender' && (
    <svg class="symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <line x1="3" y1="10" x2="21" y2="10" />
      <line x1="8" y1="3" x2="8" y2="7" />
      <line x1="16" y1="3" x2="16" y2="7" />
      <path d="M8 15l2.5 2.5L16 12" />
    </svg>
  )
}

<style>
  .symbol {
    width: 1.5rem;
    height: 1.5rem;
    display: block;
  }
</style>
