---
import type { Bereich } from '../bereiche';

interface Props {
  url: string;
  bereich: Bereich;
  titel: string;
  beschreibung: string;
  veroeffentlicht: Date;
  schlagworte?: string[];
  titelbild?: string;
}
const {
  url,
  bereich,
  titel,
  beschreibung,
  veroeffentlicht,
  schlagworte = [],
  titelbild,
} = Astro.props;

const datumLesbar = veroeffentlicht.toLocaleDateString('de-DE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const datumMaschine = veroeffentlicht.toISOString().slice(0, 10);
---

<li class="blogkarte" data-bereich={bereich.id}>
  <article>
    {
      /* Ohne Titelbild wird gar kein Bildbereich gerendert. Eine leere
         Farbfläche als Ersatz sieht nach "hier fehlt etwas" aus - kein
         Bild ist ehrlicher und ruhiger. */
      titelbild && (
        <a href={url} class="blogkarte__bild-link" tabindex="-1" aria-hidden="true">
          <img class="blogkarte__bild" src={titelbild} alt="" loading="lazy" />
        </a>
      )
    }
    <div class="blogkarte__inhalt">
      <span class="etikett" data-bereich={bereich.id}>{bereich.name}</span>
      <h3 class="blogkarte__titel">
        <a href={url}>{titel}</a>
      </h3>
      <p class="blogkarte__text leise">{beschreibung}</p>
      <p class="blogkarte__meta leise">
        <time datetime={datumMaschine}>{datumLesbar}</time>
        {
          schlagworte.length > 0 && (
            <>
              <span aria-hidden="true"> · </span>
              <span>{schlagworte.join(', ')}</span>
            </>
          )
        }
      </p>
    </div>
  </article>
</li>

<style>
  .blogkarte {
    background: var(--karte);
    border: 1px solid var(--haarlinie);
    border-radius: var(--karte-radius);
    box-shadow: var(--karte-schatten);
    overflow: hidden;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .blogkarte:hover {
    border-color: color-mix(in srgb, var(--akzent) 45%, var(--haarlinie));
    transform: translateY(-2px);
    box-shadow: var(--karte-schatten-aktiv);
  }

  .blogkarte article {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .blogkarte__bild-link {
    display: block;
    line-height: 0;
  }

  .blogkarte__bild {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .blogkarte__inhalt {
    padding: var(--karte-innen-mobil);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .etikett {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--schrift-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    margin-bottom: var(--raum-12);
    color: var(--familie);
    /* 10 Prozent auf Weiß statt 14 Prozent auf Papier: Bei der alten
       Mischung lag der Kontrast bei 4,38 und 4,49 zu 1 und damit knapp
       unter den geforderten 4,5. Jetzt sind es 5,0 (Familie), 6,1
       (Praxis) und 5,2 (Lernen). Die Palette selbst bleibt unberührt -
       geändert hat sich nur, wie stark die Farbe aufgehellt wird. */
    background: color-mix(in srgb, var(--familie) 10%, var(--karte));
  }
  .etikett[data-bereich='praxis'] {
    color: var(--praxis);
    background: color-mix(in srgb, var(--praxis) 10%, var(--karte));
  }
  .etikett[data-bereich='lernen'] {
    color: var(--lernen);
    background: color-mix(in srgb, var(--lernen) 10%, var(--karte));
  }

  .blogkarte__titel {
    font-size: var(--gross-h3);
    line-height: var(--zeile-h3);
    margin: 0 0 var(--raum-8);
  }
  .blogkarte__titel a {
    text-decoration: none;
  }
  .blogkarte__titel a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .blogkarte__text {
    margin: 0 0 var(--raum-12);
    font-size: var(--gross-klein);
    line-height: var(--zeile-klein);
    flex: 1;
  }

  .blogkarte__meta {
    margin: 0;
    font-size: var(--gross-klein);
  }
</style>
