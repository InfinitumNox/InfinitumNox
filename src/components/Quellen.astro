---
/**
 * Woher die Zahlen kommen.
 *
 * Steht bewusst als fester Text unter dem Rechner und nicht im
 * Ergebnis: So ist die Herkunft der Werte auch dann zu sehen, wenn
 * noch niemand gerechnet hat - und auch ohne JavaScript.
 *
 * Gepflegt wird die Liste in src/data/schlaf-regeln.json.
 */
import regeln from '../data/schlaf-regeln.json';

const quellen = regeln.quellen ?? [];
const stand = regeln.stand?.wert ?? '';

// Eine Quelle ohne brauchbare Adresse wird als Text gezeigt, nicht als
// toter Link. Platzhalter sind noch keine Adresse.
const istAdresse = (wert: string) => /^https?:\/\//i.test(wert.trim());
---

<section class="quellen" aria-labelledby="quellen-titel">
  <h2 id="quellen-titel" class="quellen__titel">Woher die Werte stammen</h2>

  <ul class="quellen__liste">
    {
      quellen.map((q) => (
        <li class="quellen__eintrag">
          <span class="quellen__kuerzel">{q.kuerzel}</span>
          <span>
            {istAdresse(q.url) ? <a href={q.url}>{q.titel}</a> : q.titel}
            <span class="quellen__name"> &middot; {q.name}</span>
            {q.abgerufen && <span class="quellen__abruf"> (abgerufen am {q.abgerufen})</span>}
          </span>
        </li>
      ))
    }
  </ul>

  {stand && <p class="quellen__stand">Stand: {stand}</p>}
</section>

<style>
  .quellen {
    background: var(--karte);
    border: 1px solid var(--haarlinie);
    border-radius: var(--karte-radius);
    box-shadow: var(--karte-schatten);
    padding: var(--karte-innen-mobil);
    font-size: var(--gross-klein);
    line-height: var(--zeile-klein);
    color: var(--tinte-leise);
  }

  .quellen__titel {
    font-size: var(--gross-h3);
    line-height: var(--zeile-h3);
    color: var(--tinte);
    margin: 0 0 var(--raum-12);
  }

  .quellen__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--raum-8);
  }

  .quellen__eintrag {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--raum-8);
    align-items: baseline;
  }

  .quellen__kuerzel {
    font-family: var(--schrift-display);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--akzent);
    background: color-mix(in srgb, var(--akzent) 12%, var(--karte));
    border-radius: 999px;
    padding: 2px var(--raum-8);
    white-space: nowrap;
  }

  .quellen__name,
  .quellen__abruf {
    color: var(--tinte-leise);
  }

  .quellen__stand {
    margin: var(--raum-12) 0 0;
    padding-top: var(--raum-12);
    border-top: 1px solid var(--haarlinie);
  }

  @media (min-width: 48rem) {
    .quellen { padding: var(--raum-32); }
  }
</style>
