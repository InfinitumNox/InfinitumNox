---
/**
 * Der Kita-Schlaf-Rechner.
 *
 * Läuft vollständig im Browser der Besucherin: keine Serveranfrage,
 * keine Speicherung, kein Tracking, kein Sprachmodell. Die Einschätzung
 * kommt aus einem festen Entscheidungsbaum in
 * src/data/schlaf-regeln.json.
 *
 * Ohne JavaScript bleibt alles lesbar - das Formular, die Erklärung,
 * der Abgrenzungshinweis und die Quellen. Nur das Rechnen selbst
 * entfällt, und darauf weist ein Hinweis hin.
 */
import regeln from '../data/schlaf-regeln.json';
import autorin from '../data/autorin.json';
import { findePlatzhalter } from '../platzhalter.mjs';
import {
  ALTER_OPTIONEN,
  ANLIEGEN,
  MITTAGSSCHLAF_MAX,
  MITTAGSSCHLAF_MIN,
  MITTAGSSCHLAF_SCHRITT,
  VORGABE,
  pruefeRegeln,
} from '../schlaf';

// Der Warnbalken. In der echten Produktion wird er nie gebraucht,
// weil der Bau dort schon abgebrochen ist (siehe astro.config.mjs).
const offen = [
  ...findePlatzhalter(regeln).map((p) => `schlaf-regeln.json → ${p}`),
  ...findePlatzhalter(autorin).map((p) => `autorin.json → ${p}`),
];
const fehler = pruefeRegeln(regeln);
const zeigeWarnung = offen.length > 0 || fehler.length > 0;

const abgrenzung = regeln.abgrenzung;
const ausblick = regeln.ausblick;
---

<section class="rechner" id="kita-schlaf" aria-labelledby="rechner-titel">
  {
    zeigeWarnung && (
      <div class="warnbalken" role="alert">
        <p class="warnbalken__titel">
          Dieser Rechner ist noch nicht fertig und darf nicht online gehen.
        </p>
        {offen.length > 0 && (
          <p class="warnbalken__text">
            In <code>src/data/</code> sind {offen.length} Einträge als
            Platzhalter markiert. Die angezeigten Zeiten sind deshalb
            bedeutungslos. Ein Bau der echten Seite bricht an dieser Stelle ab.
          </p>
        )}
        {fehler.length > 0 && (
          <ul class="warnbalken__liste">
            {fehler.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        )}
        {offen.length > 0 && (
          <details class="warnbalken__details">
            <summary>Offene Einträge anzeigen</summary>
            <ul class="warnbalken__liste">
              {offen.map((p) => (
                <li><code>{p}</code></li>
              ))}
            </ul>
          </details>
        )}
      </div>
    )
  }

  <h2 id="rechner-titel" class="rechner__titel">Das Schlaffenster berechnen</h2>

  <p class="rechner__datenschutz">
    Alle Berechnungen laufen in Ihrem Browser. Wir speichern keine Angaben
    über Ihr Kind.
  </p>

  <form class="formular" id="schlaf-formular" novalidate>
    <div class="feld">
      <label for="alter">Alter des Kindes</label>
      <select id="alter" name="alter" class="eingabe">
        {
          ALTER_OPTIONEN.map((jahre) => (
            <option value={jahre} selected={jahre === VORGABE.alter}>
              {jahre} Jahre
            </option>
          ))
        }
      </select>
    </div>

    <div class="feld">
      <label for="aufstehzeit">Aufstehzeit</label>
      <input
        type="time"
        id="aufstehzeit"
        name="aufstehzeit"
        class="eingabe"
        value={VORGABE.aufstehzeit}
        required
      />
    </div>

    <div class="feld">
      <label for="zubettgehzeit">Aktuelle Zubettgehzeit</label>
      <input
        type="time"
        id="zubettgehzeit"
        name="zubettgehzeit"
        class="eingabe"
        value={VORGABE.zubettgehzeit}
        required
      />
    </div>

    <fieldset class="feld feld--breit">
      <legend>Mittagsschlaf in der Kita</legend>
      <div class="schalter">
        <label class="schalter__wahl">
          <input type="radio" name="mittagsschlaf" value="ja" checked />
          <span>Ja</span>
        </label>
        <label class="schalter__wahl">
          <input type="radio" name="mittagsschlaf" value="nein" />
          <span>Nein</span>
        </label>
      </div>
    </fieldset>

    <div class="feld feld--breit" id="dauer-feld">
      <label for="dauer">
        Dauer des Mittagsschlafs
        <output for="dauer" id="dauer-wert" class="feld__wert">60 Minuten</output>
      </label>
      <input
        type="range"
        id="dauer"
        name="dauer"
        class="regler"
        min={MITTAGSSCHLAF_MIN}
        max={MITTAGSSCHLAF_MAX}
        step={MITTAGSSCHLAF_SCHRITT}
        value={VORGABE.mittagsschlafMinuten}
      />
      <div class="regler__skala" aria-hidden="true">
        <span>0 Min.</span>
        <span>{MITTAGSSCHLAF_MAX} Min.</span>
      </div>
    </div>

    <div class="feld feld--breit">
      <label for="anliegen">Was beschäftigt Sie?</label>
      <select id="anliegen" name="anliegen" class="eingabe">
        {
          ANLIEGEN.map((a) => (
            <option value={a.id} selected={a.id === VORGABE.anliegen}>
              {a.text}
            </option>
          ))
        }
      </select>
    </div>

    <div class="feld feld--breit">
      <button type="submit" class="knopf">Schlaffenster berechnen</button>
    </div>
  </form>

  <noscript>
    <p class="hinweis">
      Für die Berechnung braucht dieser Rechner JavaScript. Der Grund ist
      derselbe, aus dem wir nichts speichern: Die Rechnung läuft in Ihrem
      Browser und nicht auf unserem Server. Wenn Sie JavaScript
      eingeschaltet lassen möchten, erklären die Abschnitte unter dem
      Formular trotzdem, worauf es beim Schlaf von Kita-Kindern ankommt.
    </p>
  </noscript>

  <!-- Das Ergebnis erscheint hier, ohne dass die Seite neu lädt. -->
  <div id="ergebnis" class="ergebnis-bereich" aria-live="polite"></div>

  {
    abgrenzung && (
      <section class="block block--abgrenzung">
        <h3 class="block__titel">{abgrenzung.titel}</h3>
        <p>{abgrenzung.einleitung}</p>
        <ul>
          {abgrenzung.punkte.map((p: string) => (
            <li>{p}</li>
          ))}
        </ul>
      </section>
    )
  }

  {
    ausblick && (
      <section class="block block--ausblick">
        <h3 class="block__titel">{ausblick.titel}</h3>
        <p>{ausblick.text}</p>
      </section>
    )
  }
</section>

<script>
  import regeln from '../data/schlaf-regeln.json';
  import {
    ausAdresse,
    berechne,
    seitAufstehen,
    zuAdresse,
    zuUhrzeit,
    VORGABE,
    type Balken,
    type Eingaben,
  } from '../schlaf';

  const formular = document.getElementById('schlaf-formular') as HTMLFormElement | null;
  const ergebnisBereich = document.getElementById('ergebnis');
  const dauerFeld = document.getElementById('dauer-feld');
  const dauerRegler = document.getElementById('dauer') as HTMLInputElement | null;
  const dauerWert = document.getElementById('dauer-wert');

  if (formular && ergebnisBereich && dauerFeld && dauerRegler && dauerWert) {
    // -------------------------------------------------------------
    // Kleine Helfer. Der Ergebnistext wird über textContent gesetzt
    // und nie über innerHTML - so kann aus der Regeldatei kein
    // Markup in die Seite geraten.
    // -------------------------------------------------------------
    const el = <K extends keyof HTMLElementTagNameMap>(
      art: K,
      klasse?: string,
      inhalt?: string
    ): HTMLElementTagNameMap[K] => {
      const knoten = document.createElement(art);
      if (klasse) knoten.className = klasse;
      if (inhalt !== undefined) knoten.textContent = inhalt;
      return knoten;
    };

    const gewaehltesRadio = () =>
      formular.querySelector<HTMLInputElement>('input[name="mittagsschlaf"]:checked');

    // -------------------------------------------------------------
    // Formular lesen und schreiben
    // -------------------------------------------------------------
    function lese(): Eingaben {
      const daten = new FormData(formular!);
      return {
        alter: Number(daten.get('alter')),
        aufstehzeit: String(daten.get('aufstehzeit') ?? ''),
        mittagsschlaf: daten.get('mittagsschlaf') === 'ja',
        mittagsschlafMinuten: Number(daten.get('dauer')),
        zubettgehzeit: String(daten.get('zubettgehzeit') ?? ''),
        anliegen: String(daten.get('anliegen')) as Eingaben['anliegen'],
      };
    }

    function schreibe(e: Eingaben) {
      const setze = (name: string, wert: string) => {
        const feld = formular!.elements.namedItem(name);
        if (feld instanceof HTMLInputElement || feld instanceof HTMLSelectElement) {
          feld.value = wert;
        }
      };
      setze('alter', String(e.alter));
      setze('aufstehzeit', e.aufstehzeit);
      setze('zubettgehzeit', e.zubettgehzeit);
      setze('dauer', String(e.mittagsschlafMinuten));
      setze('anliegen', e.anliegen);

      formular!
        .querySelectorAll<HTMLInputElement>('input[name="mittagsschlaf"]')
        .forEach((r) => {
          r.checked = r.value === (e.mittagsschlaf ? 'ja' : 'nein');
        });
    }

    // -------------------------------------------------------------
    // Dauer-Feld: nur sichtbar, wenn es einen Mittagsschlaf gibt
    // -------------------------------------------------------------
    function dauerAnzeigen() {
      const ja = gewaehltesRadio()?.value === 'ja';
      dauerFeld!.hidden = !ja;
    }

    function dauerBeschriften() {
      const minuten = Number(dauerRegler!.value);
      dauerWert!.textContent = `${minuten} Minuten`;
    }

    formular
      .querySelectorAll<HTMLInputElement>('input[name="mittagsschlaf"]')
      .forEach((r) => r.addEventListener('change', dauerAnzeigen));
    dauerRegler.addEventListener('input', dauerBeschriften);

    // -------------------------------------------------------------
    // Der Tagesbalken.
    //
    // Das eine Element, an das sich Nutzerinnen erinnern sollen: der
    // Tag des Kindes als waagerechter Balken. Er macht auf einen Blick
    // sichtbar, worum es hier eigentlich geht - dass der Mittagsschlaf
    // in der Kita das Abendbett nach hinten schiebt. Andere
    // Schlafrechner geben nur eine Stundenzahl aus.
    //
    // Umgesetzt mit HTML und Prozentwerten statt SVG, damit die
    // Beschriftung auch auf einem 320 Pixel breiten Handy in echter
    // Schriftgröße lesbar bleibt und nicht mitskaliert.
    //
    // Der Balken selbst ist für Screenreader ausgeblendet: Unter ihm
    // steht dieselbe Information als Text, und die ist die bessere
    // Vorlesefassung.
    // -------------------------------------------------------------
    function zeichneTagesbalken(b: Balken): HTMLElement {
      const anteil = (zeitpunkt: number) =>
        Math.max(0, Math.min(100, (seitAufstehen(zeitpunkt, b.aufstehen) / b.achseLaenge) * 100));

      const figur = el('figure', 'balken');

      // --- Beschriftung über dem Balken, nur an den beiden Enden.
      // Alles andere würde sich auf schmalen Geräten überlagern.
      const kopf = el('div', 'balken__enden');
      const links = el('div', 'balken__ende');
      links.append(el('span', 'balken__ende-titel', 'Aufstehen'));
      links.append(el('span', 'balken__ende-zeit', `${zuUhrzeit(b.aufstehen)} Uhr`));
      // Rechts steht die Zubettgehzeit und nicht noch einmal das
      // Fenster: Das Fenster ist die Überschrift direkt darüber, und
      // die Uhrzeit ist das, was heute Abend tatsächlich zu tun ist.
      const rechts = el('div', 'balken__ende balken__ende--rechts');
      rechts.append(el('span', 'balken__ende-titel', 'Ins Bett'));
      rechts.append(el('span', 'balken__ende-zeit', `${zuUhrzeit(b.empfehlung)} Uhr`));
      kopf.append(links, rechts);
      figur.append(kopf);

      // --- Die Spur selbst.
      const spur = el('div', 'balken__spur');
      spur.setAttribute('aria-hidden', 'true');

      if (b.mittagVon !== null && b.mittagBis !== null) {
        const mittag = el('div', 'balken__mittag');
        mittag.style.left = `${anteil(b.mittagVon)}%`;
        mittag.style.width = `${anteil(b.mittagBis) - anteil(b.mittagVon)}%`;
        spur.append(mittag);
      }

      const fenster = el('div', 'balken__fenster');
      fenster.style.left = `${anteil(b.fensterVon)}%`;
      fenster.style.width = `${anteil(b.fensterBis) - anteil(b.fensterVon)}%`;
      spur.append(fenster);

      const marke = el('div', 'balken__marke');
      marke.style.left = `${anteil(b.empfehlung)}%`;
      spur.append(marke);

      const heute = el('div', 'balken__heute');
      heute.style.left = `${anteil(b.aktuell)}%`;
      spur.append(heute);

      figur.append(spur);

      // --- Legende. Sie trägt die volle Information als Text und ist
      // damit zugleich die barrierefreie Fassung des Balkens.
      const legende = el('ul', 'balken__legende');
      const eintrag = (art: string, text: string) => {
        const li = el('li', 'balken__legende-eintrag');
        li.append(el('span', `balken__muster balken__muster--${art}`));
        li.append(el('span', undefined, text));
        return li;
      };

      if (b.mittagVon !== null && b.mittagBis !== null) {
        legende.append(
          eintrag(
            'mittag',
            `Mittagsschlaf in der Kita: ${zuUhrzeit(b.mittagVon)} – ${zuUhrzeit(b.mittagBis)} Uhr`
          )
        );
      }
      legende.append(
        eintrag(
          'fenster',
          `Empfohlenes Schlaffenster: ${zuUhrzeit(b.fensterVon)} – ${zuUhrzeit(b.fensterBis)} Uhr`
        )
      );
      legende.append(eintrag('marke', `Empfohlene Zubettgehzeit: ${zuUhrzeit(b.empfehlung)} Uhr`));
      legende.append(eintrag('heute', `Aktuelle Zubettgehzeit: ${zuUhrzeit(b.aktuell)} Uhr`));

      const beschriftung = el('figcaption', 'balken__legende-huelle');
      beschriftung.append(legende);
      figur.append(beschriftung);

      return figur;
    }

    // -------------------------------------------------------------
    // Ergebnis aufbauen
    // -------------------------------------------------------------
    function zeige(eingaben: Eingaben) {
      const ergebnis = berechne(eingaben, regeln);
      ergebnisBereich!.replaceChildren();

      if (!ergebnis) {
        ergebnisBereich!.append(
          el(
            'p',
            'hinweis',
            'Diese Angaben ergeben noch kein Ergebnis. Bitte prüfen Sie Aufstehzeit und Zubettgehzeit.'
          )
        );
        return;
      }

      const karte = el('div', 'ergebnis');

      karte.append(el('p', 'ergebnis__augenbraue', 'Empfohlenes Schlaffenster'));
      karte.append(
        el('p', 'ergebnis__fenster', `${ergebnis.fensterVon} – ${ergebnis.fensterBis} Uhr`)
      );

      const empfehlung = el('p', 'ergebnis__empfehlung');
      empfehlung.append(document.createTextNode('Empfohlene Zubettgehzeit: '));
      empfehlung.append(el('strong', undefined, `${ergebnis.empfehlung} Uhr`));
      karte.append(empfehlung);

      karte.append(zeichneTagesbalken(ergebnis.balken));
      karte.append(el('p', 'ergebnis__abweichung', ergebnis.abweichungSatz));

      // Einschätzung aus dem Entscheidungsbaum
      const ursache = el('section', 'ergebnis__ursache');
      ursache.append(el('h3', 'ergebnis__untertitel', ergebnis.ursache.titel));
      ursache.append(el('p', undefined, ergebnis.ursache.erklaerung));

      if (ergebnis.ursache.schritte.length > 0) {
        ursache.append(el('h4', 'ergebnis__schritte-titel', 'Die ersten drei Schritte'));
        const liste = el('ol', 'ergebnis__schritte');
        ergebnis.ursache.schritte.forEach((s) => liste.append(el('li', undefined, s)));
        ursache.append(liste);
      }
      karte.append(ursache);

      ergebnisBereich!.append(karte);
    }

    // -------------------------------------------------------------
    // Adresszeile: macht ein Ergebnis teilbar. Es wandern nur die
    // eingegebenen Werte hinein, keine personenbezogenen Angaben.
    // -------------------------------------------------------------
    function adresseAktualisieren(eingaben: Eingaben) {
      const adresse = new URL(location.href);
      adresse.search = zuAdresse(eingaben).toString();
      adresse.hash = 'kita-schlaf';
      history.replaceState(null, '', adresse);
    }

    function scrolleZumErgebnis() {
      const sanft = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      ergebnisBereich!.scrollIntoView({
        behavior: sanft ? 'smooth' : 'auto',
        block: 'start',
      });
    }

    formular.addEventListener('submit', (ereignis) => {
      ereignis.preventDefault();
      const eingaben = lese();
      zeige(eingaben);
      adresseAktualisieren(eingaben);
      scrolleZumErgebnis();
    });

    // -------------------------------------------------------------
    // Start: geteilte Adresse übernehmen, sonst nur das Formular
    // vorbereiten. Ungefragt gerechnet wird nicht.
    // -------------------------------------------------------------
    const geteilt = ausAdresse(location.search);
    if (geteilt) {
      schreibe(geteilt);
      dauerAnzeigen();
      dauerBeschriften();
      zeige(geteilt);
    } else {
      schreibe(VORGABE);
      dauerAnzeigen();
      dauerBeschriften();
    }
  }
</script>

<!-- ==================================================================
     Achtung, das ist kein Versehen: Dieser Block ist global.

     Astro schreibt seine gekapselten Stile über ein zusätzliches
     Attribut in die Vorlage. Elemente, die das Skript erst im Browser
     erzeugt - und das gesamte Ergebnis samt Tagesbalken entsteht so -
     bekommen dieses Attribut nicht und werden von gekapselten Stilen
     schlicht nicht getroffen.

     Deshalb steht die Gestaltung des Ergebnisbereichs hier als
     is:global. Jeder Selektor ist mit #ergebnis vorangestellt, damit
     trotzdem nichts außerhalb dieses einen Bereichs berührt wird.
     ================================================================== -->
<style is:global>
  /* ============ Ergebnis ============ */
  #ergebnis.ergebnis-bereich:not(:empty) { margin-top: var(--raum-32); }

  /* Auch der Hinweis bei unbrauchbaren Eingaben entsteht erst im
     Browser und braucht deshalb eine globale Regel. */
  #ergebnis .hinweis {
    margin: var(--raum-16) 0 0;
    font-size: var(--gross-klein);
    line-height: var(--zeile-klein);
    color: var(--tinte-leise);
  }

  #ergebnis .ergebnis {
    border-top: 1px solid var(--haarlinie);
    padding-top: var(--raum-24);
  }

  #ergebnis .ergebnis__augenbraue {
    font-family: var(--schrift-display);
    font-size: var(--gross-klein);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--akzent);
    margin: 0 0 var(--raum-4);
  }

  #ergebnis .ergebnis__fenster {
    font-family: var(--schrift-display);
    font-weight: 600;
    font-size: var(--gross-h1);
    line-height: var(--zeile-h1);
    letter-spacing: -0.02em;
    margin: 0 0 var(--raum-8);
  }

  #ergebnis .ergebnis__empfehlung { margin: 0 0 var(--raum-24); }
  #ergebnis .ergebnis__abweichung { margin: 0 0 var(--raum-24); }

  /* ============ Tagesbalken ============
     Die einzige Stelle, an der die Seite gestalterisch auffällig sein
     darf. Alles andere bleibt ruhig. */
  #ergebnis .balken {
    margin: 0 0 var(--raum-24);
  }

  #ergebnis .balken__enden {
    display: flex;
    justify-content: space-between;
    gap: var(--raum-16);
    margin-bottom: var(--raum-8);
  }

  #ergebnis .balken__ende {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  #ergebnis .balken__ende--rechts { text-align: right; }

  #ergebnis .balken__ende-titel {
    font-family: var(--schrift-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tinte-leise);
  }

  #ergebnis .balken__ende-zeit {
    font-family: var(--schrift-display);
    font-weight: 600;
    font-size: var(--gross-h3);
    line-height: var(--zeile-h3);
    white-space: nowrap;
  }

  #ergebnis .balken__spur {
    position: relative;
    height: 44px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--haarlinie) 45%, var(--papier));
    border: 1px solid var(--haarlinie);
    overflow: hidden;
  }

  /* Der Mittagsschlaf: schräg schraffiert, damit er sich vom
     Schlaffenster auch ohne Farbe unterscheidet. */
  #ergebnis .balken__mittag {
    position: absolute;
    top: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--akzent) 38%, var(--karte)) 0 6px,
      color-mix(in srgb, var(--akzent) 22%, var(--karte)) 6px 12px
    );
    border-inline: 1px solid color-mix(in srgb, var(--akzent) 55%, var(--karte));
  }

  /* Das Schlaffenster: ruhige Fläche, kräftiger als der Mittagsschlaf. */
  #ergebnis .balken__fenster {
    position: absolute;
    top: 0;
    bottom: 0;
    background: color-mix(in srgb, var(--akzent) 65%, var(--karte));
  }

  /* Die empfohlene Zubettgehzeit: durchgezogener Strich. */
  #ergebnis .balken__marke {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    margin-left: -1.5px;
    background: var(--tinte);
  }

  /* Die aktuelle Zubettgehzeit: gestrichelt, damit klar ist, dass sie
     der Ist-Zustand ist und nicht die Empfehlung. */
  #ergebnis .balken__heute {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 2px dashed var(--tinte-leise);
  }

  #ergebnis .balken__legende-huelle { margin: var(--raum-8) 0 0; }

  #ergebnis .balken__legende {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--raum-4);
    font-size: var(--gross-klein);
    line-height: var(--zeile-klein);
    color: var(--tinte-leise);
  }

  #ergebnis .balken__legende-eintrag {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: var(--raum-8);
    align-items: center;
  }

  #ergebnis .balken__muster {
    display: block;
    height: 12px;
    border-radius: 3px;
  }
  #ergebnis .balken__muster--mittag {
